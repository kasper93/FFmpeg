slot=amd64-clang-asan-asm
comment="Clang ASAN/UBSAN/ASM"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=amd64
extra_cflags="-fno-sanitize-recover=undefined"
extra_ldflags="-fuse-ld=lld -fno-sanitize-recover=undefined"
extra_conf="--toolchain=llvm-asan-ubsan --enable-debug=lldb --disable-stripping --enable-version3 --enable-nonfree --enable-vulkan"
