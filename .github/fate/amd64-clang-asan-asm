slot=amd64-clang-asan-asm
comment="Clang ASAN/UBSAN/ASM"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
arch=amd64
as=clang
cc=clang
ld=clang
extra_cflags="-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined"
extra_ldflags="-fuse-ld=lld -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined"
extra_conf="--ar=llvm-ar --cxx=clang++ --nm=llvm-nm --strip=llvm-strip --ranlib=llvm-ranlib --enable-debug=lldb --disable-stripping --enable-version3 --enable-nonfree"
