slot=amd64-msvc-asan
comment="VS2022 MSVC AMD64 (ASAN)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
arch=amd64
extra_cflags="-fsanitize=address -MD"
extra_conf="--toolchain=msvc --target-os=win64 --disable-asm --enable-w32threads --enable-version3 --enable-nonfree --extra-cxxflags=-MD --enable-vulkan --enable-libglslang"
