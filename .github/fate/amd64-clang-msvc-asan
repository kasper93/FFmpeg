slot=amd64-clang-msvc-asan
comment="VS2026 Clang AMD64 (ASAN)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=amd64
# -fno-sanitize=function for https://github.com/llvm/llvm-project/issues/145160
extra_cflags="-fno-sanitize-recover=undefined -fno-sanitize=function"
extra_ldflags="-fuse-ld=lld -fno-sanitize-recover=undefined -fno-sanitize=function"
extra_conf="--toolchain=llvm-asan-ubsan --target-os=win64 --disable-asm --enable-w32threads --enable-version3 --enable-nonfree"
