slot=amd64-clang-msvc-asan
comment="VS2026 Clang AMD64 (ASAN)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=amd64
as=clang
cc=clang
ld=clang
# -fno-sanitize=function for https://github.com/llvm/llvm-project/issues/145160
extra_cflags="-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-sanitize=function"
extra_ldflags="-fuse-ld=lld -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-sanitize=function"
extra_conf="--ar=llvm-ar --cxx=clang++ --nm=llvm-nm --strip=llvm-strip --ranlib=llvm-ranlib --windres=llvm-rc --target-os=win64 --disable-asm --enable-w32threads --enable-version3 --enable-nonfree"
# TODO: those flags shouldn't be needed
extra_conf+=" --host_extralibs=''"
