slot=arm64-msvc-cet
comment="VS2022 MSVC ARM64 (CET)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
arch=arm64
extra_cflags="-guard:signret -MD"
extra_cxxflags="-guard:signret -MD"
extra_ldflags="-guard:delayloadsignret"
extra_conf="--toolchain=msvc --disable-debug --target-os=win64 --enable-w32threads --enable-version3 --enable-nonfree --disable-vulkan"
