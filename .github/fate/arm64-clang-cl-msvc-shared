slot=arm64-clang-cl-msvc-shared
comment="VS2022 Clang-CL ARM64 (shared)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=arm64
cc=clang-cl
cxx=clang-cl
extra_cflags="-MD"
extra_cxxflags="-MD"
extra_conf="--toolchain=msvc --disable-debug --target-os=win64 --enable-shared --enable-w32threads --enable-version3 --enable-nonfree --enable-vulkan --enable-libglslang"
