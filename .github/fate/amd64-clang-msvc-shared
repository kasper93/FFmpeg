slot=amd64-clang-msvc-shared
comment="VS2026 Clang AMD64 (shared)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=amd64
extra_ldflags="-fuse-ld=lld"
extra_conf="--toolchain=llvm --target-os=win64 --enable-shared --enable-w32threads --enable-version3 --enable-nonfree"
# TODO: those flags shouldn't be needed
extra_conf+=" --host_extralibs=''"
