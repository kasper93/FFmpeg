slot=arm64-clang-cl-msvc
comment="VS2022 Clang-CL ARM64"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
arch=arm64
cc=clang-cl
extra_cflags="-MD"
extra_conf="--cxx=clang-cl --toolchain=msvc --disable-debug --target-os=win64 --enable-w32threads --enable-version3 --enable-nonfree --extra-cxxflags=-MD --enable-vulkan --enable-libglslang"
