slot=amd64-gcc-snapshot-short-enums
comment="GCC AMD64 (short-enums)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=amd64
cc=gcc
cxx=g++
extra_cflags="-fshort-enums"
extra_cxxflags="-fshort-enums"
# extra_ldflags="-fuse-ld=mold"
extra_conf="--disable-stripping --enable-version3 --enable-nonfree --enable-vulkan --enable-libglslang"
