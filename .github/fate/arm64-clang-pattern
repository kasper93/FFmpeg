slot=arm64-clang-pattern
comment="Clang (auto-var-init=pattern)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=arm64
cc=clang
cxx=clang++
extra_cflags="-ftrivial-auto-var-init=pattern"
extra_cxxflags="-ftrivial-auto-var-init=pattern"
extra_conf="--enable-debug=lldb --disable-stripping --enable-version3 --enable-nonfree"
