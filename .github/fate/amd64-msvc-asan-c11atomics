slot=amd64-msvc-asan-c11atomics
comment="VS2026 MSVC AMD64 (ASAN, C11 atomics)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=amd64
extra_cflags="-fsanitize=address -MD -experimental:c11atomics"
extra_cxxflags="-fsanitize=address -MD"
extra_conf="--toolchain=msvc --target-os=win64 --disable-asm --enable-w32threads --enable-version3 --enable-nonfree --enable-vulkan"
