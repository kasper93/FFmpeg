slot=arm64-clang-cl-msvc-asan
comment="VS2022 Clang-CL ARM64 (ASAN)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=arm64
cc=clang-cl
cxx=clang-cl
# -fno-sanitize=function for https://github.com/llvm/llvm-project/issues/145160
extra_cflags="-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-sanitize=function -MD"
extra_cxxflags="-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-sanitize=function -MD"
# clang-cl supports autolinking only for -fsanitize=undefined, not for address, unlike cl.exe
extra_ldflags="clang_rt.asan_dynamic-aarch64.lib clang_rt.asan_dynamic_runtime_thunk-aarch64.lib"
extra_conf="--toolchain=msvc --target-os=win64 --disable-asm --enable-w32threads --enable-version3 --enable-nonfree --enable-vulkan"
