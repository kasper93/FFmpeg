slot=msys2-mingw32
comment="MSYS2 MINGW32"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=x86_32
extra_cflags="-DCL_TARGET_OPENCL_VERSION=300 -isystem $MSYSTEM_PREFIX/include/opencv4 -isystem $MSYSTEM_PREFIX/include/svt-av1"
extra_cxxflags="-DCL_TARGET_OPENCL_VERSION=300 -isystem $MSYSTEM_PREFIX/include/opencv4 -isystem $MSYSTEM_PREFIX/include/svt-av1"
extra_conf="--disable-stripping --enable-version3 --enable-nonfree --cpu=native --enable-dxva2 --enable-d3d11va --enable-gmp --enable-libfreetype --enable-libharfbuzz --enable-libmp3lame --enable-libvorbis --enable-libwebp --enable-libxml2 --enable-opengl"
