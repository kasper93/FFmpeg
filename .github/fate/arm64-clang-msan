slot=arm64-clang-msan
comment="Clang MSAN"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=arm64
extra_ldflags="-fuse-ld=lld"
extra_conf="--toolchain=llvm-msan --enable-debug=lldb --disable-stripping --disable-memory-poisoning --disable-asm --enable-version3 --enable-nonfree --enable-vulkan --enable-libshaderc"
