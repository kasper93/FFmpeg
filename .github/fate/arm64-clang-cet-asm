slot=arm64-clang-cet-asm
comment="Clang (BTI/PAC-RET)"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
skip_clean=yes
arch=arm64
extra_cflags="-mbranch-protection=standard"
extra_cxxflags="-mbranch-protection=standard"
extra_ldflags="-fuse-ld=lld"
extra_conf="--toolchain=llvm --enable-debug=lldb --disable-stripping --enable-version3 --enable-nonfree --disable-vulkan"
