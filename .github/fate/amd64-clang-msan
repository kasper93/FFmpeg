slot=amd64-clang-msan
comment="Clang MSAN"
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
arch=amd64
as=clang
cc=clang
ld=clang
extra_cflags="-fsanitize=memory -fsanitize-memory-track-origins -fno-omit-frame-pointer"
extra_ldflags="-fuse-ld=lld -fsanitize=memory -fsanitize-memory-track-origins -fno-omit-frame-pointer"
extra_conf="--ar=llvm-ar --cxx=clang++ --nm=llvm-nm --strip=llvm-strip --ranlib=llvm-ranlib --enable-debug=lldb --disable-stripping --disable-memory-poisoning --disable-asm --enable-version3 --enable-nonfree"
