slot=amd64-clang-cl-msvc-shared
comment="VS2022 Clang-CL AMD64 (shared)"
build_only=yes
fate_recv="ssh -T -o IdentitiesOnly=yes fate@fate.ffmpeg.org"
fate_targets="fate fate-build"
repo="file://$PWD"
samples="../samples"
makeopts=-j`nproc`
arch=amd64
cc=clang-cl
extra_conf="--cxx=clang-cl --toolchain=msvc --disable-debug --target-os=win64 --enable-shared --enable-w32threads --enable-version3 --enable-nonfree"
