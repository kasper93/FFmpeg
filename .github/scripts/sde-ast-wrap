#!/bin/sh
set -u

oast=$(mktemp "${TMPDIR:-/tmp}/sde-ast.XXXXXX") || exit 125
trap 'rm -f "$oast"' EXIT

# Use glibc's SSE string/mem routines; their AVX versions transition against
# FFmpeg's SSE C code. That's just noise, we can hide. In fact there is a single
# test `fate-filter-crazychannels` that does trigger a transition.
export GLIBC_TUNABLES=glibc.cpu.hwcaps=-AVX2,-AVX

sde64 -ast -oast "$oast" -- "$@"
status=$?

# Sum the two SUMMARY counters (AVX_to_SSE / SSE_to_AVX) from the report.
transitions=$(awk -F: '/_transition_instances:/ { gsub(/[^0-9]/, "", $2); s += $2 } END { print s + 0 }' "$oast")

if [ "${transitions:-0}" -gt 0 ]; then
    echo "sde-ast: $transitions AVX<->SSE transition(s) detected" >&2
    cat "$oast" >&2
    exit 1
fi

exit "$status"
